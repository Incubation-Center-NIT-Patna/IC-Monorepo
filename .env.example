# Database connection string (Required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/ic"

# Better Auth Configuration (Required)
# Generate a secret using: npx auth secret
BETTER_AUTH_SECRET="your-super-secret-auth-string-must-be-32-chars-long"
BETTER_AUTH_URL="http://localhost:4000"

# API URL for Frontend (Required)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# CORS Origins for API (Optional, defaults to localhost:3000 and 7030)
CORS_ORIGIN="http://localhost:3000,http://localhost:7030"

# Google OAuth Configuration (Required for Google Sign-in)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Allowed Google Domains for sign-in (Optional)
# e.g., "nitp.ac.in"
# GOOGLE_ALLOWED_DOMAINS="nitp.ac.in"

# WhatsApp / SMS Configuration (Required for phone sign-in)
AISENSY_API_KEY="your-aisensy-api-key"

# Super Admin Seed Details (Optional)
# Used when running Prisma seed to create the initial super admin
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="Your_Password_123"

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ic
POSTGRES_PORT=5432

MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=minio-password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET=ic-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1


STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio-admin
STORAGE_SECRET_KEY=minio-password
STORAGE_BUCKET=ic-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PROVIDER=minio

API_PORT=4000

# Added for API Validation
JWT_SECRET="your-super-secret-jwt-key-must-be-32-chars-long"
GEMINI_API_KEY="your-gemini-api-key"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="ic-documents"
