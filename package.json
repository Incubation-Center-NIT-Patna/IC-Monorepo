{
  "name": "Incubation-Center",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:studio": "dotenv -- pnpm --filter @repo/database exec prisma studio",
    "db:generate": "dotenv -- pnpm --filter @repo/database exec prisma generate",
    "db:migrate:dev": "dotenv -- pnpm --filter @repo/database exec prisma migrate dev",
    "db:status": "dotenv -- pnpm --filter @repo/database run db:status",
    "db:seed": "dotenv -- pnpm --filter @repo/database exec tsx prisma/seed/index.ts"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "8",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2",
    "yaml": "2.4.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "swiper>react": "18.3.1",
      "swiper>react-dom": "18.3.1"
    }
  }
}
